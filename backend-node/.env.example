# ─── Plagit Backend — Environment Configuration ───
# Copy this file: cp .env.example .env
# Then fill in real values for each variable.

# ── Server ──
PORT=3000
NODE_ENV=development                    # development | production

# ── Database (development — individual fields) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plagit
DB_USER=
DB_PASSWORD=

# ── Database (production — single connection string) ──
# DATABASE_URL=postgres://user:password@host:5432/plagit
# DB_SSL=true                           # set to "false" to disable SSL

# ── Authentication ──
# Generate a strong secret for production: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── CORS ──
# Comma-separated origins, or * for all (dev only)
# Production: https://app.plagit.com,https://admin.plagit.com
CORS_ORIGIN=*

# ── Email (Resend) ──
# Without this, password reset codes are logged to console only
# Get API key at: https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@yourdomain.com

# ── AI / CV Parsing (Anthropic Claude) ──
# Without this, CV upload returns raw text without AI extraction
# Get API key at: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Push Notifications (Firebase / FCM) ──
# Without these, push is in log mode only (safe default for dev)
# PUSH_REAL_ENABLED=false                    # set to 'true' in production
# FCM_SERVICE_ACCOUNT_JSON={"type":"..."}    # Firebase service account JSON

# ── VoIP Push (Apple PushKit — CallKit sprint, Step D) ──
# Required for direct APNs VoIP pushes (firebase-admin cannot send VoIP pushes)
# Obtain the .p8 key at: https://developer.apple.com/account/resources/authkeys
# The same key used for FCM's APNs auth works here too (account-level key).
# VOIP_PUSH_ENABLED=false                   # arms apnsVoipSender; OFF = total no-op (production default)
# APNS_KEY_ID=XXXXXXXXXX                    # 10-char Key ID from Apple Developer (filename AuthKey_<id>.p8)
# APNS_TEAM_ID=XXXXXXXXXX                   # 10-char Team ID (6CVZ9J92UW for Plagit)
# APNS_BUNDLE_ID=com.plagit.plagit          # main bundle id; voip topic = <bundle>.voip
# Provide the .p8 EITHER inline (Railway) …
# APNS_VOIP_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"  # .p8 contents — NEVER commit a real key
# … OR by path (local dev — keeps the key out of .env):
# APNS_VOIP_KEY_PATH=~/secure/plagit/AuthKey_XXXXXXXXXX.p8
# APNS_VOIP_PRODUCTION=true                 # 'false' targets the APNs sandbox; TestFlight/App Store use production

# ── Call Ring Sweep Cron ──
# Flips ringing calls older than 60s to missed. Default OFF.
# CALL_RING_SWEEP_ENABLED=false

# --- Call reliability: STUN / TURN (Call Reliability Phase 1) --------------
# Without TURN the WebRTC engine falls back to STUN-only, which fails behind
# symmetric NAT and carrier CGNAT — the usual "it rings but nobody hears
# anything". Leave everything blank and calls still work on friendly networks;
# the ice-servers endpoint degrades honestly and logs the degradation.
#
# Which provider mints the credentials: "cloudflare" or "coturn" (default).
# The two use DIFFERENT authentication models and must never be mixed.
TURN_PROVIDER=cloudflare

# --- Cloudflare Calls TURN (TURN_PROVIDER=cloudflare) ---------------------
# The backend asks Cloudflare for short-lived ICE credentials per request. The
# key id and API token are server-only and never reach the app.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# --- Self-hosted coturn (TURN_PROVIDER=coturn) ----------------------------
# Comma-separated. Offer UDP first, TCP for UDP-blocked networks, and TLS on
# 443 for restrictive hotel / venue wifi, where often only 443 gets out.
TURN_URLS=
# coturn REST shared secret. NEVER sent to the app: the server derives a
# short-lived username/credential pair from it per request.
TURN_STATIC_AUTH_SECRET=
# Only for providers that mint their own long-lived pair out-of-band.
# Ephemeral credentials take precedence when the shared secret is also set.
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Shared ---------------------------------------------------------------
# Credential lifetime in seconds.
#   cloudflare: default 86400 (24h), clamped 60..172800
#   coturn:     default 600,          clamped 60..3600
# The client caches the ICE config for the whole app session and has NO
# refresh path, so a Cloudflare credential must outlive both a
# long-backgrounded app and the longest call. Do not shorten this without
# first adding credential refresh on the client.
TURN_TTL_SECONDS=86400
# Optional STUN override. Defaults to Google's public STUN. Ignored in
# cloudflare mode, which returns its own STUN alongside TURN.
STUN_URLS=
# QA only: comma-separated user ids served `iceTransportPolicy: relay`, which
# forces every candidate through TURN and so PROVES the relay works.
ICE_RELAY_QA_USER_IDS=
# QA only: "1" forces relay-only for every user. Staging environments only —
# it relays traffic that would otherwise have gone peer-to-peer.
ICE_FORCE_RELAY_ALL=

# ─── Plagit Backend — Environment Configuration ───
# Copy this file: cp .env.example .env
# Then fill in real values for each variable.

# ── Server ──
PORT=3000
NODE_ENV=development                    # development | production

# ── Database (development — individual fields) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plagit
DB_USER=
DB_PASSWORD=

# ── Database (production — single connection string) ──
# DATABASE_URL=postgres://user:password@host:5432/plagit
# DB_SSL=true                           # set to "false" to disable SSL

# ── Authentication ──
# Generate a strong secret for production: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── CORS ──
# Comma-separated origins, or * for all (dev only)
# Production: https://app.plagit.com,https://admin.plagit.com
CORS_ORIGIN=*

# ── Email (Resend) ──
# Without this, password reset codes are logged to console only
# Get API key at: https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@yourdomain.com

# ── AI / CV Parsing (Anthropic Claude) ──
# Without this, CV upload returns raw text without AI extraction
# Get API key at: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Push Notifications (Firebase / FCM) ──
# Without these, push is in log mode only (safe default for dev)
# PUSH_REAL_ENABLED=false                    # set to 'true' in production
# FCM_SERVICE_ACCOUNT_JSON={"type":"..."}    # Firebase service account JSON

# ── VoIP Push (Apple PushKit — CallKit sprint, Step D) ──
# Required for direct APNs VoIP pushes (firebase-admin cannot send VoIP pushes)
# Obtain the .p8 key at: https://developer.apple.com/account/resources/authkeys
# The same key used for FCM's APNs auth works here too (account-level key).
# VOIP_PUSH_ENABLED=false                   # arms apnsVoipSender; OFF = total no-op (production default)
# APNS_KEY_ID=XXXXXXXXXX                    # 10-char Key ID from Apple Developer (filename AuthKey_<id>.p8)
# APNS_TEAM_ID=XXXXXXXXXX                   # 10-char Team ID (6CVZ9J92UW for Plagit)
# APNS_BUNDLE_ID=com.plagit.plagit          # main bundle id; voip topic = <bundle>.voip
# Provide the .p8 EITHER inline (Railway) …
# APNS_VOIP_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"  # .p8 contents — NEVER commit a real key
# … OR by path (local dev — keeps the key out of .env):
# APNS_VOIP_KEY_PATH=~/secure/plagit/AuthKey_XXXXXXXXXX.p8
# APNS_VOIP_PRODUCTION=true                 # 'false' targets the APNs sandbox; TestFlight/App Store use production

# ── Call Ring Sweep Cron ──
# Flips ringing calls older than 60s to missed. Default OFF.
# CALL_RING_SWEEP_ENABLED=false
